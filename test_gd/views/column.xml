<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record model="ir.ui.view" id="column_view_form">
        <field name="name">test_gd.column_view_form</field>
        <field name="model">test_gd.column</field>
        <field name="arch" type="xml">
            <form string="Author Form">
                <sheet>
                    <group>
                        <h1>
                            <field name="name" string="Name"/>
                            <field name="column_type" string="Type"/>
                        </h1>
                     </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_column_list" model="ir.ui.view">
        <field name="name">test_gd.column.list</field>
        <field name="model">test_gd.column</field>
        <field name="arch" type="xml">
            <list create="1" delete="1" multi_edit="1" string="Columns">
                <field name="name" string="Name"/>
                <field name="column_type" string="Type"/>
            </list>
        </field>
    </record>

</odoo>
